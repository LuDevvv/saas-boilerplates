# ============================================================
# 🚀 Startup Edge Stack — Environment Variables
# ============================================================
# Copy this file and rename it to .env (or .dev.vars for Wrangler)
# Fill in the values for your environment.
# Variables marked [REQUIRED] must be set for the app to function.
# Variables marked [OPTIONAL] have defaults or are non-critical.
# ============================================================

# ----------------------------------------------------------
# 🗄️ DATABASE (Neon Serverless PostgreSQL)
# ----------------------------------------------------------
# [REQUIRED] Neon HTTP pooler connection string.
# Get it from: https://console.neon.tech → Project → Connection Details → Select "Pooled" + "HTTP"
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ----------------------------------------------------------
# 🔐 AUTHENTICATION
# ----------------------------------------------------------
# [REQUIRED] Secret key for signing JWT access tokens. Must be ≥ 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET="your-secret-key-min-32-chars-here"

# [REQUIRED] Master key for encrypting sensitive data at rest (AES-GCM). Must be ≥ 32 characters.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-encryption-key-base64-here"

# [REQUIRED] Public URL of the frontend app. Used for CORS origin validation and CSRF.
PUBLIC_APP_URL="http://localhost:4321"

# [REQUIRED] Cloudflare Turnstile CAPTCHA server-side secret key.
# Get it from: https://dash.cloudflare.com → Turnstile → Site → Secret Key
TURNSTILE_SECRET_KEY="0x..."

# ----------------------------------------------------------
# 🔑 OAUTH PROVIDERS
# ----------------------------------------------------------
# [REQUIRED if using Google OAuth]
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# [REQUIRED if using Facebook OAuth]
# Get from: https://developers.facebook.com → App Settings → Basic
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# [REQUIRED if using GitHub OAuth]
# Get from: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ----------------------------------------------------------
# 💳 BILLING — Multi-Provider
# ----------------------------------------------------------
# [REQUIRED] Which payment provider to use. Options: "polar"
BILLING_PROVIDER="polar"

# --- Polar.sh ---
# [REQUIRED if BILLING_PROVIDER="polar"]
# Get from: https://polar.sh → Settings → API Tokens
POLAR_ACCESS_TOKEN="polar_at_your-polar-access-token"
# [REQUIRED if BILLING_PROVIDER="polar"]
# Get from: https://polar.sh → Settings → Webhooks → Secret
POLAR_WEBHOOK_SECRET="whsec_your-polar-webhook-secret"

# --- (Legacy/Alternative Providers) ---
# LEMONSQUEEZY_API_KEY="..."
# CREEM_API_KEY="..."


# ----------------------------------------------------------
# 📧 EMAIL (Resend) — Used by Jobs Worker
# ----------------------------------------------------------
# [REQUIRED] Transactional email API key.
# Sign up at: https://resend.com → API Keys
RESEND_API_KEY="re_your-resend-api-key"

# ----------------------------------------------------------
# 📦 FILE STORAGE (Cloudflare R2)
# ----------------------------------------------------------
# [REQUIRED] R2 bucket name as configured in your Cloudflare dashboard.
R2_BUCKET_NAME="your-r2-bucket-name"
# [REQUIRED] R2 API credentials for presigned URL generation.
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# [REQUIRED] R2 S3-compatible endpoint.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# [REQUIRED] Public URL for serving R2 objects (via custom domain or r2.dev).
R2_PUBLIC_URL="https://assets.yourdomain.com"

# ----------------------------------------------------------
# 📊 OBSERVABILITY
# ----------------------------------------------------------
# --- Sentry (Error Tracking) ---
# [REQUIRED] Get from: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# [OPTIONAL] Environment name (default: "production")
SENTRY_ENVIRONMENT="development"
# [OPTIONAL] Percentage of transactions to trace (0.0 - 1.0, default: 1.0)
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Axiom (Structured Logging) ---
# [REQUIRED] Get from: https://axiom.co → Settings → API Tokens
AXIOM_TOKEN="xaat-your-axiom-token"
# [REQUIRED] Dataset name where logs are sent
AXIOM_DATASET="edge-api-logs"

# --- PostHog (Product Analytics) ---
# [REQUIRED] Get from: https://posthog.com → Project Settings → Project API Key
POSTHOG_PROJECT_KEY="phc_your-posthog-project-key"
# [OPTIONAL] PostHog API key for server-side events
POSTHOG_API_KEY=""
# [OPTIONAL] PostHog host (default: https://app.posthog.com)
POSTHOG_HOST="https://app.posthog.com"

# ----------------------------------------------------------
# ⚙️ RUNTIME
# ----------------------------------------------------------
# [REQUIRED] Application environment. Options: "development" | "production" | "test"
NODE_ENV="development"

# ----------------------------------------------------------
# ☁️ CLOUDFLARE BINDINGS (wrangler.toml)
# ----------------------------------------------------------
# The following are Cloudflare-specific bindings configured in wrangler.toml,
# NOT in .env files. They are listed here for documentation purposes only.
#
# R2_BUCKET       → R2 Bucket binding (configured in wrangler.toml [[r2_buckets]])
# JOBS_QUEUE      → Queue producer binding (configured in wrangler.toml [[queues.producers]])
# EMAIL_QUEUE     → Queue producer binding (configured in wrangler.toml [[queues.producers]])
# USAGE_KV        → KV Namespace binding (configured in wrangler.toml [[kv_namespaces]])
# CACHE_KV        → KV Namespace binding (configured in wrangler.toml [[kv_namespaces]])
# RATE_LIMIT_KV   → KV Namespace binding (configured in wrangler.toml [[kv_namespaces]])
# RATE_LIMITER    → Rate Limiting binding (configured in wrangler.toml [[unsafe.bindings]])
