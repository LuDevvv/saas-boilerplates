---
import {
    LayoutDashboard,
    Briefcase,
    Users,
    Settings,
    User,
    ShieldCheck,
    CreditCard,
    LogOut,
    Menu,
    X,
    Search,
    Command,
    PlusCircle,
    Bell,
    PanelLeftClose,
    PanelLeftOpen,
    Globe,
    HelpCircle,
    Sparkles,
    Sun,
    Moon,
    ChevronLeft,
    ChevronRight,
} from "lucide-react";
import Layout from "./Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Logo } from "../components/Logo";
import { UserAvatar } from "../components/dashboard/UserAvatar";
import { WorkspaceSwitcher } from "../components/dashboard/WorkspaceSwitcher";
import { AppShell } from "../components/dashboard/AppShell";
import { cn } from "@workspace/ui";

interface Props {
    title: string;
}

const { title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const mainNav = [
    { href: "/dashboard", label: "Updates", icon: Bell },
    { href: "/team", label: "Members", icon: Users },
    { href: "/workspaces", label: "Workspaces", icon: Briefcase },
];

const accountNav = [
    { href: "/profile", label: "Account Settings", icon: User },
    { href: "/billing", label: "Subscription", icon: CreditCard },
    { href: "/settings/security", label: "Security & Keys", icon: ShieldCheck },
    { href: "/settings", label: "Preferences", icon: Settings },
];
---

<Layout title={title}>
    <script slot="head" is:inline>
        // Critical blocking state detection to prevent FOUC (Flash of Unstyled Content)
        (function() {
            const token = localStorage.getItem("token");
            if (!token && window.location.pathname !== "/login") {
                window.location.href = "/login";
            }
            
            // Apply sidebar state immediately to HTML element
            const isSidebarCollapsed = localStorage.getItem("sidebar-collapsed") === "true";
            if (isSidebarCollapsed) {
                document.documentElement.classList.add('sidebar-collapsed');
            }

            // Apply theme immediately
            const theme = localStorage.getItem('theme') || 
                         (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <AppShell client:load>
        <div
            id="app-shell"
            class="flex min-h-screen bg-[hsl(var(--background))] selection:bg-primary/20"
        >
            <!-- Sidebar Shell (Astro) -->
            <aside
                id="main-sidebar"
                class="fixed inset-y-0 left-0 w-64 bg-[hsl(var(--sidebar-background))] border-r border-border/10 hidden md:flex flex-col z-40 transition-all duration-500 group/sidebar"
            >
                <div class="px-4 py-8 flex flex-col h-full relative overflow-visible">
                    {/* Sidebar Header - Logo & Toggle */}
                    <div class="flex flex-col gap-2 mb-8 group-[.sidebar-collapsed]/sidebar:items-center">
                        <div class="flex items-center justify-between group-[.sidebar-collapsed]/sidebar:justify-center w-full px-2 transition-all duration-500">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-foreground flex items-center justify-center font-black text-background text-lg shadow-2xl transition-transform duration-500 group-hover/sidebar:rotate-3">
                                    L
                                </div>
                                <span class="text-sm font-black tracking-[0.2em] uppercase sidebar-collapse-hide whitespace-nowrap overflow-hidden transition-all duration-500">
                                    L.A. Labs
                                </span>
                            </div>
                            <button id="sidebar-toggle" class="sidebar-toggle-btn sidebar-collapse-hide p-1.5 hover:bg-secondary/10 rounded-lg transition-all text-muted-foreground/30 hover:text-foreground">
                                <PanelLeftClose className="w-[17px] h-[17px]" />
                            </button>
                        </div>
                        {/* Collapsed Toggle Button - Centered under the logo */}
                        <button id="sidebar-toggle-collapsed" class="sidebar-collapse-show hidden p-1.5 hover:bg-secondary/10 rounded-lg transition-all text-muted-foreground/30 hover:text-foreground">
                            <PanelLeftOpen className="w-5 h-5 shadow-inner" />
                        </button>
                    </div>

                    <!-- Main Navigation -->
                    <nav class="flex-1 space-y-6 overflow-y-auto custom-scrollbar">
                        <div class="space-y-0.5">
                             <div class="sidebar-collapse-hide px-3 mb-3">
                                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/20">Active View</span>
                            </div>
                            {mainNav.map((item: any) => {
                                const isActive = Astro.url.pathname === item.href || (item.href !== "/dashboard" && Astro.url.pathname.startsWith(item.href));
                                return (
                                    <div class="relative group/nav-item">
                                        <a
                                            href={item.href}
                                            class:list={[
                                                "sidebar-link flex items-center gap-3 h-9 transition-all duration-300 rounded-xl",
                                                "md:group-[.sidebar-collapsed]/sidebar:justify-center md:group-[.sidebar-collapsed]/sidebar:px-0 px-3",
                                                isActive
                                                    ? "text-foreground bg-secondary/15"
                                                    : "text-muted-foreground/50 hover:text-foreground hover:bg-secondary/5",
                                            ]}
                                        >
                                            <item.icon className="w-[17px] h-[17px] shrink-0" />
                                            <span class="flex-1 sidebar-collapse-hide transition-all duration-500 whitespace-nowrap font-bold text-[13px] tracking-tight">
                                                {item.label}
                                            </span>
                                        </a>
                                        {/* Tooltip for Collapsed Mode */}
                                        <div class="fixed left-[76px] px-2.5 py-1.5 bg-foreground text-background text-[10px] font-black uppercase tracking-widest rounded-lg opacity-0 pointer-events-none md:group-[.sidebar-collapsed]/sidebar:group-hover/nav-item:opacity-100 transition-all duration-300 z-[100] whitespace-nowrap shadow-xl border border-border/10 translate-x-1 group-hover/nav-item:translate-x-3">
                                            {item.label}
                                            <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-foreground rotate-45 rounded-sm -z-10" />
                                        </div>
                                    </div>
                                );
                            })}
                        </div>

                        <div class="space-y-0.5">
                            <div class="sidebar-collapse-hide px-3 mb-3">
                                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/20">Foundation</span>
                            </div>
                            {accountNav.map((item: any) => {
                                const isActive = Astro.url.pathname === item.href || (item.href !== "/dashboard" && Astro.url.pathname.startsWith(item.href));
                                return (
                                    <div class="relative group/nav-item">
                                        <a
                                            href={item.href}
                                            class:list={[
                                                "sidebar-link flex items-center gap-3 h-9 transition-all duration-300 rounded-xl",
                                                "md:group-[.sidebar-collapsed]/sidebar:justify-center md:group-[.sidebar-collapsed]/sidebar:px-0 px-3",
                                                isActive
                                                    ? "text-foreground bg-secondary/15"
                                                    : "text-muted-foreground/50 hover:text-foreground hover:bg-secondary/5",
                                            ]}
                                        >
                                            <item.icon className="w-[17px] h-[17px] shrink-0" />
                                            <span class="flex-1 sidebar-collapse-hide transition-all duration-500 whitespace-nowrap font-bold text-[13px] tracking-tight">
                                                {item.label}
                                            </span>
                                        </a>
                                        {/* Tooltip for Collapsed Mode */}
                                        <div class="fixed left-[76px] px-2.5 py-1.5 bg-foreground text-background text-[10px] font-black uppercase tracking-widest rounded-lg opacity-0 pointer-events-none md:group-[.sidebar-collapsed]/sidebar:group-hover/nav-item:opacity-100 transition-all duration-300 z-[100] whitespace-nowrap shadow-xl border border-border/10 translate-x-1 group-hover/nav-item:translate-x-3">
                                            {item.label}
                                            <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-foreground rotate-45 rounded-sm -z-10" />
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </nav>

                    <!-- Sidebar Footer -->
                    <div class="mt-auto space-y-3 pt-6 border-t border-border/5 group-[.sidebar-collapsed]/sidebar:items-center flex flex-col transition-all duration-500">
                        <div class="w-full relative group/switcher-parent">
                             <WorkspaceSwitcher client:load />
                             {/* Tooltip */}
                             <div class="fixed left-[76px] px-2.5 py-1.5 bg-foreground text-background text-[10px] font-black uppercase tracking-widest rounded-lg opacity-0 pointer-events-none md:group-[.sidebar-collapsed]/sidebar:group-hover/switcher-parent:opacity-100 transition-all duration-300 z-[100] whitespace-nowrap shadow-xl border border-border/10 translate-x-3 group-hover/switcher-parent:translate-x-4">
                                Organizations
                                <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-foreground rotate-45 rounded-sm -z-10" />
                             </div>
                        </div>

                        <!-- Theme Toggle HUD Control -->
                        <div class="relative group/theme w-full flex justify-center">
                            <button
                                id="theme-toggle"
                                class="flex items-center justify-between w-full h-11 border border-border/10 bg-secondary/10 hover:bg-secondary/20 rounded-xl px-3 transition-all duration-300 group/theme-btn group-[.sidebar-collapsed]/sidebar:w-11 group-[.sidebar-collapsed]/sidebar:px-0 group-[.sidebar-collapsed]/sidebar:justify-center outline-none"
                                aria-label="Toggle Theme"
                            >
                                <div class="flex items-center gap-3 sidebar-collapse-hide flex-1">
                                    <div class="relative w-4 h-4 shrink-0 overflow-hidden">
                                        <Sun className="w-4 h-4 absolute inset-0 transition-transform duration-500 scale-100 dark:scale-0 dark:rotate-90" />
                                        <Moon className="w-4 h-4 absolute inset-0 transition-transform duration-500 scale-0 rotate-90 dark:scale-100 dark:rotate-0" />
                                    </div>
                                    <span class="font-black text-[10px] tracking-[0.15em] uppercase text-muted-foreground/30 group-hover/theme-btn:text-foreground">
                                        Display Mode
                                    </span>
                                </div>
                                
                                {/* Centered Icons for Collapsed Mode only */}
                                <div class="hidden group-[.sidebar-collapsed]/sidebar:flex items-center justify-center">
                                    <Sun className="w-4 h-4 dark:hidden" />
                                    <Moon className="w-4 h-4 hidden dark:block text-primary" />
                                </div>

                                <div class="w-2 h-2 rounded-full bg-primary/20 flex items-center justify-center sidebar-collapse-hide group-hover/theme-btn:scale-110 transition-transform">
                                    <div class="w-1 h-1 rounded-full bg-primary" />
                                </div>
                            </button>
                            {/* Tooltip */}
                            <div class="fixed left-[76px] px-2.5 py-1.5 bg-foreground text-background text-[10px] font-black uppercase tracking-widest rounded-lg opacity-0 pointer-events-none md:group-[.sidebar-collapsed]/sidebar:group-hover/theme:opacity-100 transition-all duration-300 z-[100] whitespace-nowrap shadow-xl border border-border/10 translate-x-3 group-hover/theme:translate-x-4">
                                Switch Appearance
                                <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-foreground rotate-45 rounded-sm -z-10" />
                            </div>
                        </div>

                        <!-- User Profile HUD Control -->
                        <UserAvatar client:load />
                    </div>
                </div>
            </aside>

            <!-- Main Content -->
            <!-- Mobile Sidebar Overlay -->
            <div
                id="sidebar-overlay"
                class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[60] hidden md:hidden transition-all duration-300 opacity-0"
            >
            </div>

            <!-- Mobile Sidebar Drawer -->
            <aside
                id="sidebar-mobile"
                class="fixed inset-y-0 left-0 w-80 bg-[hsl(var(--sidebar-background))] z-[70] transform -translate-x-full transition-transform duration-500 ease-in-out md:hidden flex flex-col shadow-2xl"
            >
                <div class="flex items-center justify-between p-6 h-20 border-b border-border/5">
                    <div class="flex items-center gap-3">
                        <Logo size="sm" />
                        <h1 class="text-sm font-black tracking-[0.2em] uppercase">
                            L.A. Labs
                        </h1>
                    </div>
                    <button
                        id="sidebar-close-btn"
                        class="p-2 text-muted-foreground/40 hover:text-foreground transition-all outline-none bg-secondary/10 rounded-xl"
                    >
                        <X className="w-5 h-5" />
                    </button>
                </div>

                <div class="px-6 py-8">
                    <WorkspaceSwitcher client:load />
                </div>

                <div class="flex-1 overflow-y-auto px-6 pb-12 custom-scrollbar space-y-8">
                    <div class="space-y-1.5">
                        <div class="px-4 mb-3">
                             <span class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/20">Systems</span>
                        </div>
                        {
                            mainNav.map((item: any) => {
                                const isActive = Astro.url.pathname === item.href || (item.href !== "/dashboard" && Astro.url.pathname.startsWith(item.href));
                                return (
                                    <a
                                        href={item.href}
                                        class:list={[
                                            "flex items-center gap-4 px-4 h-12 rounded-2xl transition-all duration-300 font-bold",
                                            isActive
                                                ? "bg-secondary/15 text-foreground"
                                                : "text-muted-foreground/50 hover:bg-secondary/5",
                                        ]}
                                    >
                                        <item.icon className="w-5 h-5 opacity-40 shrink-0" />
                                        <span class="text-[15px] tracking-tight">
                                            {item.label}
                                        </span>
                                    </a>
                                );
                            })
                        }
                    </div>

                    <div class="space-y-1.5">
                        <div class="px-4 mb-3">
                             <span class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/20">Identity</span>
                        </div>
                        {
                            accountNav.map((item: any) => {
                                const isActive = Astro.url.pathname === item.href || (item.href !== "/dashboard" && Astro.url.pathname.startsWith(item.href));
                                return (
                                    <a
                                        href={item.href}
                                        class:list={[
                                            "flex items-center gap-4 px-4 h-12 rounded-2xl transition-all duration-300 font-bold",
                                            isActive
                                                ? "bg-secondary/15 text-foreground"
                                                : "text-muted-foreground/50 hover:bg-secondary/5",
                                        ]}
                                    >
                                        <item.icon className="w-5 h-5 opacity-40 shrink-0" />
                                        <span class="text-[15px] tracking-tight">
                                            {item.label}
                                        </span>
                                    </a>
                                );
                            })
                        }
                    </div>
                </div>

                <div class="p-6 border-t border-border/10 mt-auto bg-secondary/5">
                    <div class="flex items-center justify-between mb-6">
                        <span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground/30">Infrastructure Mode</span>
                        <div class="flex p-1 bg-background rounded-lg border border-border/5">
                             <button class="p-1.5 rounded-md text-primary bg-secondary/20 shadow-sm"><Sun className="w-4 h-4" /></button>
                             <button class="p-1.5 rounded-md text-muted-foreground/40"><Moon className="w-4 h-4" /></button>
                        </div>
                    </div>
                    <UserAvatar client:load />
                </div>
            </aside>

            <!-- Main Content Area -->
            <div
                id="main-content"
                class="flex-1 md:ml-64 flex flex-col transition-all duration-500 min-w-0"
            >
                <header
                    class="h-16 flex md:hidden items-center justify-between px-6 bg-[hsl(var(--sidebar-background))] sticky top-0 z-20 border-b border-border/10"
                >
                    <button
                        id="sidebar-open-btn"
                        class="w-10 h-10 flex items-center justify-center bg-secondary/10 rounded-xl text-foreground"
                    >
                        <Menu className="w-5 h-5" />
                    </button>
                    
                    <div class="w-8 h-8 rounded-lg bg-foreground flex items-center justify-center font-black text-background text-sm">L</div>
                </header>

                <main
                    class="container-inset flex-1 animate-premium-in min-w-0"
                >
                    <slot />
                </main>
            </div>
        </div>
    </AppShell>

    <script>
        // Theme Management Logic
        const themeToggle = document.getElementById("theme-toggle");
        
        // Initialize Theme from Storage
        const theme = localStorage.getItem('theme') || 
                     (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        themeToggle?.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });

        // Sidebar Management Logic
        const sidebar = document.getElementById("main-sidebar");
        const toggleBtn = document.getElementById("sidebar-toggle");
        const toggleBtnCollapsed = document.getElementById("sidebar-toggle-collapsed");

        function toggleSidebar() {
            const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
            localStorage.setItem("sidebar-collapsed", isCollapsed.toString());
            
            // Dispatch event for React components that might care
            window.dispatchEvent(new CustomEvent('sidebar-state-change', { detail: { collapsed: isCollapsed } }));
        }

        toggleBtn?.addEventListener("click", toggleSidebar);
        toggleBtnCollapsed?.addEventListener("click", toggleSidebar);

        // Mobile sidebar toggle
        const overlay = document.getElementById("sidebar-overlay");
        const drawer = document.getElementById("sidebar-mobile");
        const openBtn = document.getElementById("sidebar-open-btn");
        const closeBtn = document.getElementById("sidebar-close-btn");

        openBtn?.addEventListener("click", () => {
            overlay?.classList.remove("hidden");
            setTimeout(() => {
                drawer?.classList.remove("-translate-x-full");
                overlay?.classList.add("opacity-100");
            }, 10);
            document.body.style.overflow = "hidden";
        });

        const closeSidebar = () => {
            drawer?.classList.add("-translate-x-full");
            overlay?.classList.remove("opacity-100");
            setTimeout(() => {
                overlay?.classList.add("hidden");
            }, 500);
            document.body.style.overflow = "";
        };

        closeBtn?.addEventListener("click", closeSidebar);
        overlay?.addEventListener("click", closeSidebar);
    </script>
</Layout>

<style is:global>
    .custom-scrollbar::-webkit-scrollbar {
        width: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: hsl(var(--border) / 0.1);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: hsl(var(--muted-foreground) / 0.2);
    }
    
    /* Avoid sidebar double scrollbars */
    #main-sidebar {
        scrollbar-width: none;
    }
    #main-sidebar::-webkit-scrollbar {
        display: none;
    }

    /* Animation Refinements */
    @keyframes premium-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-premium-in {
        animation: premium-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Sidebar Transitions */
    .sidebar-collapsed #main-sidebar {
        width: 5rem;
    }
    .sidebar-collapsed #main-content {
        margin-left: 5rem;
    }
    .sidebar-collapsed .sidebar-collapse-hide {
        opacity: 0;
        pointer-events: none;
        width: 0;
        display: none;
    }
    .sidebar-collapsed .sidebar-collapse-show {
        display: flex !important;
    }
</style>
