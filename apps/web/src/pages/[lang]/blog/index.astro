---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const { lang } = Astro.params;
const allPosts = await getCollection("blog", (post) => {
    return post.id.startsWith(`${lang}/`);
});

// Sort by pubDate descending
const posts = allPosts.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const title = lang === "es" ? "Nuestro Blog" : "Our Blog";
const subtitle =
    lang === "es"
        ? "Lo último de L.A. Labs sobre Edge Computing."
        : "The latest from L.A. Labs on Edge Computing.";
const readMoreText = lang === "es" ? "Leer más" : "Read more";
---

<Layout title={title}>
    <section class="max-w-6xl mx-auto px-6 py-20">
        <header class="text-center mb-16 space-y-4">
            <h1
                class="text-5xl font-extrabold tracking-tight bg-gradient-to-r from-primary to-primary/60 bg-clip-text text-transparent italic lowercase"
            >
                blog.
            </h1>
            <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
                {subtitle}
            </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                posts.map((post) => {
                    const slug = post.id.split("/").slice(1).join("/");
                    const postUrl =
                        lang === "en"
                            ? `/blog/${slug}`
                            : `/${lang}/blog/${slug}`;

                    return (
                        <article class="group relative bg-card hover:bg-accent/50 transition-all border border-muted rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1">
                            {post.data.heroImage ? (
                                <img
                                    src={post.data.heroImage}
                                    alt={post.data.title}
                                    class="w-full h-48 object-cover border-b border-muted group-hover:scale-105 transition-transform duration-500"
                                />
                            ) : (
                                <div class="w-full h-48 bg-muted/30 flex items-center justify-center border-b border-muted">
                                    <svg
                                        width="40"
                                        height="40"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="text-muted-foreground/30"
                                    >
                                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
                                        <path d="M8 7h6" />
                                        <path d="M8 11h8" />
                                    </svg>
                                </div>
                            )}
                            <div class="p-6 space-y-4">
                                <div class="flex items-center gap-2 text-xs text-muted-foreground font-medium uppercase tracking-widest">
                                    <time
                                        datetime={post.data.pubDate.toISOString()}
                                    >
                                        {post.data.pubDate.toLocaleDateString(
                                            lang === "es" ? "es-ES" : "en-US",
                                        )}
                                    </time>
                                    {post.data.tags[0] && (
                                        <>
                                            <span class="w-1 h-1 rounded-full bg-muted-foreground/30" />
                                            <span>{post.data.tags[0]}</span>
                                        </>
                                    )}
                                </div>
                                <h2 class="text-2xl font-bold leading-tight group-hover:text-primary transition-colors">
                                    <a href={postUrl}>{post.data.title}</a>
                                </h2>
                                <p class="text-muted-foreground line-clamp-3 leading-relaxed">
                                    {post.data.description}
                                </p>
                                <div class="pt-2">
                                    <a
                                        href={postUrl}
                                        class="text-sm font-bold text-primary group-hover:underline flex items-center gap-2"
                                    >
                                        {readMoreText}
                                        <svg
                                            width="14"
                                            height="14"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M5 12h14m-7-7 7 7-7 7" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </section>
</Layout>
