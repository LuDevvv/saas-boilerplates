                  "if (response.success) {",
                  "    pm.collectionVariables.set(\"accessToken\", response.data.token);",
                  "    pm.collectionVariables.set(\"refreshToken\", response.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
