{
  "name": "node-stack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && find packages/ apps/ -name '*.tsbuildinfo' -delete 2>/dev/null; find packages/ apps/ -path '*/src/*' \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) -delete 2>/dev/null; echo 'Clean complete'",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "test:all": "vitest run",
    "test:cov": "turbo run test:cov",
    "test:e2e": "pnpm --filter @node-stack/e2e test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "db:seed": "pnpm --filter @node-stack/db db:seed",
    "db:seed:tenant": "pnpm --filter @node-stack/db db:seed --tenant",
    "db:studio": "pnpm --filter @node-stack/db db:studio",
    "db:push": "pnpm --filter @node-stack/db db:push",
    "db:migrate": "pnpm --filter @node-stack/db db:migrate",
    "db:clean": "pnpm --filter @node-stack/db db:clean",
    "db:generate": "pnpm --filter @node-stack/db db:generate",
    "gen:module": "tsx scripts/generate-module.ts",
    "gen:module:help": "tsx scripts/generate-module.ts --help",
    "postman:sync": "node scripts/sync-postman.js",
    "zod:types": "tsx scripts/zod-types.ts",
    "zod:types:watch": "tsx scripts/zod-types.ts --watch",
    "zod:types:clean": "tsx scripts/zod-types.ts --clean",
    "test:prep": "docker compose up -d --force-recreate && pnpm --filter @node-stack/db db:push && pnpm --filter @node-stack/db db:seed",
    "test:unit": "vitest run --project=unit",
    "test:integration": "pnpm --filter @node-stack/api test:integration",
    "test:integration:all": "pnpm -r test:integration",
    "test:integration:debug": "pnpm --filter @node-stack/api test:integration --inspect-brk",
    "test:integration:watch": "pnpm --filter @node-stack/api test:integration --watch",
    "test:integration:coverage": "pnpm --filter @node-stack/api test:integration --coverage",
    "prepare": "cd .. && husky node-stack/.husky"
  },
  "devDependencies": {
    "@swc/core": "^1.15.30",
    "@testcontainers/postgresql": "^11.13.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "fs-extra": "^11.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "openapi-to-postmanv2": "^6.0.1",
    "prettier": "^3.8.1",
    "testcontainers": "^11.13.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "turbo": "latest",
    "typescript": "5.7.3",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.7.0",
    "@polar-sh/sdk": "^0.47.0",
    "@types/pg": "^8.20.0",
    "caniuse-lite": "^1.0.30001790",
    "drizzle-orm": "^0.45.2",
    "update-browserslist-db": "^1.2.3"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/common": "11.1.19",
      "@nestjs/core": "11.1.19"
    }
  }
}
