#!/usr/bin/env sh
set -e

# Bump Node heap so the cross-package tsc graph never OOMs mid-typecheck.
# Phase 2.5 hit two transient OOMs on the in-flight working tree at the
# default 4 GB; 4096 explicit + project-references incremental cache is
# the working sweet spot for this monorepo.
export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"

# Project-references typecheck for the security-critical backend packages.
# Avoids `pnpm test` from boilerplates root because the monorepo-of-monorepos
# layout makes turbo schema resolution recursive (boilerplates root sees
# node-stack/turbo.json as a child config; node-stack/ sees the same file
# as a root). `tsc -b --noEmit` walks TypeScript project references directly
# and is the most reliable cross-package typecheck for this layout.

cd node-stack

echo "[husky] typechecking apps/api (with workspace deps)..."
(cd apps/api && npx -s tsc -b --noEmit)

echo "[husky] typechecking apps/worker (with workspace deps)..."
(cd apps/worker && npx -s tsc -b --noEmit)
