# VCS
.git
.gitignore
.gitattributes
.github

# Host-installed dependencies — each image installs its own
**/node_modules/
.pnpm-store/

# Build artifacts — packages rebuild inside Docker
**/dist/
**/*.tsbuildinfo
**/*.js.map
**/*.d.ts.map

# Test / coverage
**/coverage/
**/.nyc_output/
**/test-storage/
**/*.test.ts
**/*.spec.ts
**/vitest.config*.ts
**/jest*.config.*

# Logs
*.log
logs/

# Environment files — injected at runtime, never baked into images
.env
**/.env
**/.env.local
**/.env.*.local

# Editor & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.turbo/

# Docker files — daemon reads these directly, not via build context
docker-compose*.yml
**/.dockerignore
