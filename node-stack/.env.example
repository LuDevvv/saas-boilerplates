# =============================================================================
# Project Configuration
# =============================================================================
PROJECT_NAME=node-stack

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Direct PostgreSQL connection for Drizzle migrations — bypasses PgBouncer.
# In production: set this to postgres:5432 (NOT pgbouncer:6432).
# In local dev: can be same as DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# =============================================================================
# Redis Cache & Queue
# =============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_TTL=60000
THROTTLE_MEDIUM_LIMIT=100

# =============================================================================
# MinIO Object Storage
# =============================================================================
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =============================================================================
# pgAdmin (Optional)
# =============================================================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# =============================================================================
# Application API
# =============================================================================
API_PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.example.com

# =============================================================================
# Security (CHANGE IN PRODUCTION!)
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
ENCRYPTION_KEY=your-encryption-key-base64-encoded

# =============================================================================
# OpenTelemetry / Distributed Tracing
# =============================================================================
OTEL_SERVICE_NAME=node-stack-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# =============================================================================
# OAuth — Google
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# =============================================================================
# OAuth — GitHub
# =============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# =============================================================================
# Frontend redirect after OAuth
# =============================================================================
# =============================================================================
# Turbo Remote Cache
# =============================================================================
# Required in CI for remote caching. Get from https://vercel.com/account/tokens
# or from your self-hosted turbo-remote-cache server.
TURBO_TOKEN=
TURBO_TEAM=

# =============================================================================
# AI Provider
# =============================================================================
AI_PROVIDER=openai # openai, anthropic, or openrouter
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
