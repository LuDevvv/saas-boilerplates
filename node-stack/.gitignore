# Build & Test
dist
dist-tsc
build
out
.next
.astro
.netlify
.vercel
.turbo
coverage
*.lcov
.nyc_output
*.tsbuildinfo

# Ignore build artifacts from source folders
# (Only ignore them in folders where they are generated, like packages/ and apps/)
packages/**/*.js
packages/**/*.js.map
packages/**/*.d.ts
packages/**/*.d.ts.map
apps/**/*.js
apps/**/*.js.map
apps/**/*.d.ts
apps/**/*.d.ts.map

# Re-include hand-written source type declarations (not build output)
!apps/**/src/**/*.d.ts
!packages/**/src/**/*.d.ts

# Re-include config files if needed
!**/jest.config.js
!**/eslint.config.js
!**/next.config.js
!**/tailwind.config.js
!**/postcss.config.js
!**/vite.config.js
!**/vitest.config.js
!**/playwright.config.js

