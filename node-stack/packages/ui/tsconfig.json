{
  "compilerOptions": {
    "declaration": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node", "react", "react-dom"],
    "jsx": "react-jsx",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "paths": {
      "@node-stack/*": ["../../packages/*/src/index.ts", "../../packages/*/src"]
    }
  },
  "include": ["src/**/*"],
  "extends": "../../tsconfig.json"
}
