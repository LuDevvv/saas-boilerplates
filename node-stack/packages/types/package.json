{
    "name":  "@node-stack/types",
    "version":  "1.0.0",
    "private":  true,
    "main":  "./dist/index.js",
    "module":  "dist/index.js",
    "types":  "./dist/index.d.ts",
    "publishConfig":  {
                          "main":  "./dist/index.js",
                          "types":  "./dist/index.d.ts"
                      },
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "scripts":  {
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint src --ext .ts --max-warnings 0",
                    "build":  "tsc -b --clean \u0026\u0026 tsc -b"
                },
    "devDependencies":  {
                            "@types/node":  "^25.6.0",
                            "typescript":  "latest"
                        },
    "type":  "module"
}
