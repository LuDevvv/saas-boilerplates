{
  "compilerOptions": {
    "target": "ES2020",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "module": "Node16",
    "moduleResolution": "Node16",
    "composite": true
  },
  "include": [
    "src/**/*"
  ]
}
