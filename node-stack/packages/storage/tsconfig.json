{
    "compilerOptions":  {
                            "declaration":  true,
                            "sourceMap":  true,
                            "composite":  true,
                            "allowSyntheticDefaultImports":  true,
                            "types":  [
                                          "node"
                                      ],
                            "outDir":  "./dist",
                            "rootDir":  "./src",
                            "baseUrl":  ".",
                            "paths":  {
                                          "@node-stack/*":  [
                                                                "../../packages/*/src/index.ts",
                                                                "../../packages/*/src"
                                                            ]
                                      },
                            "jsx":  "react-jsx"
                        },
    "include":  [
                    "src/**/*"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ],
    "extends":  "../../tsconfig.json"
}
