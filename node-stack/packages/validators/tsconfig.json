{
    "extends":  "../../tsconfig.json",
    "compilerOptions":  {
                            "composite":  true,
                            "outDir":  "./dist",
                            "rootDir":  "./src",
                            "baseUrl":  ".",
                            "paths":  {
                                          "@node-stack/*":  [
                                                                "../../packages/*/src/index.ts",
                                                                "../../packages/*/src"
                                                            ]
                                      },
                            "jsx":  "react-jsx"
                        },
    "include":  [
                    "src/**/*"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ],
    "references":  [
                       {
                           "path":  "../types"
                       }
                   ]
}
