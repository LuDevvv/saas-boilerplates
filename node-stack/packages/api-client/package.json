{
  "name": "@node-stack/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./billing": {
      "types": "./dist/billing.d.ts",
      "import": "./dist/billing.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "build": "tsc -b --clean && tsc -b",
    "generate:spec": "pnpm --filter @node-stack/api openapi:export",
    "generate:types": "openapi-typescript ../../apps/api/openapi-spec.json -o src/schema.ts",
    "generate": "pnpm generate:spec && pnpm generate:types",
    "dev": "tsc -b --watch"
  },
  "dependencies": {
    "@node-stack/types": "workspace:*",
    "@node-stack/validators": "workspace:*",
    "axios": "^1.7.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.91.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "axios": "^1",
    "react": ">=18",
    "zod": "^3.24.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": { "optional": false },
    "axios": { "optional": false },
    "react": { "optional": false }
  }
}
