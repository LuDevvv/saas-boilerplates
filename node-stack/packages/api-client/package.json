{
  "name": "@node-stack/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./billing": {
      "types": "./dist/billing.d.ts",
      "import": "./dist/billing.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "build": "tsc -b --clean && tsc -b",
    "generate": "pnpm --filter @node-stack/api openapi:export && pnpm generate:client",
    "generate:client": "openapi-ts",
    "dev": "tsc -b --watch"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@node-stack/types": "workspace:*",
    "@node-stack/validators": "workspace:*",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "zod": "^3.24.1"
  }
}