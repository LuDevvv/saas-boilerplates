FROM node:20-alpine

# Install pnpm
RUN npm install -g pnpm@9.0.0

WORKDIR /app

# 1. First copy the lockfile and workspace config
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# 2. Copy the package.json files of all projects in the monorepo
# Explicit COPY to guarantee directory structure for pnpm workspace
# Only including discovered packages with valid package.json files
COPY apps/api/package.json ./apps/api/
COPY apps/dashboard/package.json ./apps/dashboard/
COPY apps/worker/package.json ./apps/worker/
COPY packages/ai-adapter/package.json ./packages/ai-adapter/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/billing-adapter/package.json ./packages/billing-adapter/
COPY packages/cache/package.json ./packages/cache/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/emails/package.json ./packages/emails/
COPY packages/notifications/package.json ./packages/notifications/
COPY packages/outbox-queue/package.json ./packages/outbox-queue/
COPY packages/queue/package.json ./packages/queue/
COPY packages/services/package.json ./packages/services/
COPY packages/storage/package.json ./packages/storage/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/validators/package.json ./packages/validators/
COPY packages/webhooks-utils/package.json ./packages/webhooks-utils/

# 3. Install dependencies - this layer will be cached unless lockfile/manifests change
# Adding network resilience to prevent ETIMEDOUT and ENOTFOUND issues
RUN pnpm config set fetch-retries 5 && \
    pnpm config set fetch-timeout 300000 && \
    pnpm config set network-concurrency 10 && \
    pnpm install --frozen-lockfile

# 4. Copy the rest of the source code
COPY . .

EXPOSE 4000

# The specific app to run is provided by the command in docker-compose.yml
CMD ["pnpm", "run", "dev"]
