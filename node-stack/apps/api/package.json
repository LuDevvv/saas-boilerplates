{
    "name": "@node-stack/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "tsc -b tsconfig.build.json --clean && tsc -b tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "dev": "nest start --watch --exec \"node --env-file=/app/.env dist/src/main.js\"",
        "dev:local": "nest start --watch --exec \"node --import tsx --env-file=../../.env\"",
        "start": "node dist/main.js",
        "start:local": "node --env-file=../../.env dist/main.js",
        "db:migrate": "drizzle-kit migrate",
        "openapi:export": "node scripts/generate-openapi-spec.js",
        "test": "vitest",
        "test:unit": "vitest run --project=api-unit",
        "test:cov": "vitest run --coverage",
        "test:e2e": "vitest run --project=api-e2e",
        "test:integration": "vitest run --project=api-integration",
        "test:integration:watch": "vitest --project=api-integration --watch",
        "lint": "eslint src --ext .ts --max-warnings 0"
    },
    "dependencies": {
        "@godaddy/terminus": "^4.12.1",
        "@nestjs/bullmq": "^11.0.0",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "latest",
        "@nestjs/core": "^11.0.0",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "latest",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "latest",
        "@nestjs/platform-socket.io": "^11.1.18",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.1.18",
        "@node-stack/ai-adapter": "workspace:*",
        "@node-stack/billing-adapter": "workspace:*",
        "@node-stack/cache": "workspace:*",
        "@node-stack/config": "workspace:*",
        "@node-stack/db": "workspace:*",
        "@node-stack/emails": "workspace:*",
        "@node-stack/notifications": "workspace:*",
        "@node-stack/outbox-queue": "workspace:*",
        "@node-stack/services": "workspace:*",
        "@node-stack/storage": "workspace:*",
        "@node-stack/types": "workspace:*",
        "@node-stack/utils": "workspace:*",
        "@node-stack/validators": "workspace:*",
        "@node-stack/webhooks-utils": "workspace:*",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.71.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
        "@opentelemetry/resources": "^2.6.0",
        "@opentelemetry/sdk-node": "^0.213.0",
        "@opentelemetry/semantic-conventions": "^1.40.0",
        "@scalar/nestjs-api-reference": "^1.1.9",
        "@sentry/nestjs": "^9.47.1",
        "@sentry/node": "^9.47.1",
        "@sentry/profiling-node": "^9",
        "@socket.io/redis-adapter": "^8.3.0",
        "bcrypt": "latest",
        "bullmq": "latest",
        "compression": "^1.7.5",
        "drizzle-kit": "latest",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.1",
        "nestjs-pino": "^4.6.1",
        "nestjs-throttler-storage-redis": "^0.5.1",
        "nestjs-zod": "^5.2.1",
        "otplib": "^13.4.0",
        "passport": "^0.7.0",
        "passport-custom": "^1.1.1",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "latest",
        "passport-local": "latest",
        "pg": "latest",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "prom-client": "^15.1.0",
        "qrcode": "^1.5.4",
        "reflect-metadata": "latest",
        "rxjs": "latest",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^10.0.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@nestjs/cli": "latest",
        "@nestjs/schematics": "latest",
        "@nestjs/testing": "latest",
        "@swc/cli": "0.6.0",
        "@swc/core": "^1.15.30",
        "@swc/helpers": "^0.5.21",
        "@types/bcrypt": "latest",
        "@types/compression": "^1.7.5",
        "@types/express": "latest",
        "@types/jest": "latest",
        "@types/node": "^25.6.0",
        "@types/passport-github2": "^1.2.9",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/passport-jwt": "latest",
        "@types/passport-local": "latest",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "ioredis-mock": "^8.9.0",
        "jest": "latest",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "supertest": "^7.0.0",
        "swc-loader": "^0.2.7",
        "ts-jest": "latest",
        "tsx": "^4.21.0",
        "typescript": "5.7.3",
        "unplugin-swc": "^1.5.9"
    }
}