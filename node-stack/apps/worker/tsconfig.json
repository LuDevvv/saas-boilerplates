{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "composite": true,
    "esModuleInterop": true,
    "rootDir": "../../"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../../packages/ai-adapter"
    },
    {
      "path": "../../packages/cache"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/emails"
    },
    {
      "path": "../../packages/services"
    },
    {
      "path": "../../packages/storage"
    },
    {
      "path": "../../packages/webhooks-utils"
    }
  ],
  "extends": "../../tsconfig.json"
}