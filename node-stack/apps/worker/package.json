{
    "name": "@node-stack/worker",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts --max-warnings 0",
        "build": "tsc -b",
        "dev": "nest start --watch --exec \"node --env-file=/app/.env dist/main.js\"",
        "dev:local": "nest start --watch --exec \"node --import tsx --env-file=../../.env\"",
        "start": "node dist/main.js",
        "start:local": "node --env-file=../../.env dist/main.js"
    },
    "dependencies": {
        "@godaddy/terminus": "^4.12.1",
        "@nestjs/bullmq": "^11.0.0",
        "@nestjs/common": "^11.1.21",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "^11.1.21",
        "@nestjs/terminus": "^11.1.1",
        "@node-stack/ai-adapter": "workspace:*",
        "@node-stack/cache": "workspace:*",
        "@node-stack/config": "workspace:*",
        "@node-stack/db": "workspace:*",
        "@node-stack/emails": "workspace:*",
        "@node-stack/services": "workspace:*",
        "@node-stack/storage": "workspace:^",
        "@node-stack/webhooks-utils": "workspace:*",
        "@opentelemetry/auto-instrumentations-node": "^0.71.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
        "@opentelemetry/resources": "^2.6.0",
        "@opentelemetry/sdk-node": "^0.213.0",
        "@opentelemetry/semantic-conventions": "^1.40.0",
        "@sentry/node": "^9",
        "@sentry/opentelemetry": "^10.49.0",
        "bullmq": "latest",
        "dotenv": "^16.0.0",
        "drizzle-orm": "0.45.2",
        "ioredis": "^5.10.1",
        "nestjs-pino": "^4.6.1",
        "opentelemetry-instrumentation-bullmq": "^0.7.15",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.21",
        "@nestjs/schematics": "^11.1.0",
        "@swc/cli": "0.6.0",
        "@swc/core": "^1.15.30",
        "@swc/helpers": "^0.5.21",
        "@types/node": "^25.6.0",
        "cross-env": "^10.1.0",
        "nodemon": "^3.1.14",
        "swc-loader": "^0.2.7",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "5.7.3",
        "unplugin-swc": "^1.5.9"
    }
}