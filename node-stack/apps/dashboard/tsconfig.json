{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Default",
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "vite/client",
      "react",
      "react-dom"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],

      // FSD Layer Paths
      "@app/*": [
        "src/app/*"
      ],
      "@features/*": [
        "src/features/*"
      ],
      "@entities/*": [
        "src/entities/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],

      // Legacy paths (gradually migrate)
      "@assets/*": [
        "src/assets/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@ui/*": [
        "src/components/ui/*"
      ],
      "@common/*": [
        "src/components/common/*"
      ],
      "@stores/*": [
        "src/stores/*"
      ],
      "@context/*": [
        "src/context/*"
      ],
      "@routes/*": [
        "src/routes/*"
      ],
      "@helpers/*": [
        "src/utils/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@styles/*": [
        "src/styles/*"
      ],
      "@api/*": [
        "src/api/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@layouts/*": [
        "src/layouts/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@data/*": [
        "src/lib/data/*"
      ],
      "@elements/*": [
        "src/components/elements*"
      ],
      "@node-stack/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@node-stack/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@node-stack/types": [
        "../../packages/types/src/index.ts"
      ],
      "@node-stack/validators": [
        "../../packages/validators/src/index.ts"
      ],
      "@node-stack/utils": [
        "../../packages/utils/src/index.ts"
      ]
    },
    "outDir": "./dist",
    "composite": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    "../../packages/ui/src/**/*",
    "../../packages/utils/src/**/*"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/api-client"
    },
    {
      "path": "../../packages/types"
    },
    {
      "path": "../../packages/validators"
    },
    {
      "path": "../../packages/utils"
    }
  ],
  "extends": "../../tsconfig.json"
}