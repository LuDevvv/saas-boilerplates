{
  "type": "module",
  "name": "@node-stack/dashboard",
  "version": "1.1.0",
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "dev": "vite --host",
    "format": "prettier --check --ignore-path .gitignore --write .",
    "lint": "eslint --ignore-path .gitignore .",
    "preview": "vite preview --host",
    "typecheck": "tsc",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "setup:auth": "node scripts/setup-auth.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formkit/auto-animate": "^0.9.0",
    "@hookform/resolvers": "^3.10.0",
    "@node-stack/api-client": "workspace:*",
    "@node-stack/types": "workspace:*",
    "@node-stack/validators": "workspace:*",
    "@tanstack/react-query": "^5.91.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "axios": "^1.7.9",
    "classnames": "^2.3.2",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.15",
    "driver.js": "^1.4.0",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.469.0",
    "plyr": "^3.8.4",
    "plyr-react": "^6.0.0",
    "qr-code-styling": "^1.9.1",
    "react-easy-crop": "^5.2.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-loading-skeleton": "^3.5.0",
    "react-phone-input-2": "^2.15.1",
    "react-phone-number-input": "^3.4.16",
    "react-qr-code": "^2.0.15",
    "sass": "^1.83.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/sortablejs": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^5.46.0",
    "@typescript-eslint/parser": "^5.46.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.13",
    "baseline-browser-mapping": "^2.9.19",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.29.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.11",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tailwindcss": "^3.7.1",
    "postcss": "^8.5.2",
    "prettier": "^2.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.1.5",
    "react-router-dom": "^7.1.5",
    "tailwindcss": "^3.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.1.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^0.25.6"
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/strict",
      "plugin:jsx-a11y/recommended",
      "plugin:prettier/recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "plugin:tailwindcss/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/consistent-type-imports": "error",
      "react/react-in-jsx-scope": "off",
      "react/no-unescaped-entities": "off",
      "tailwindcss/classnames-order": [
        "error",
        {
          "callees": [
            "classnames"
          ],
          "config": "tailwind.config.cjs"
        }
      ],
      "tailwindcss/no-custom-classname": [
        "error",
        {
          "config": "tailwind.config.cjs"
        }
      ]
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }
}