{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "paths": {
      "@node-stack/*": ["./packages/*/src/index.ts", "./packages/*/src"]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": ["node"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "composite": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "eslint.config.mjs"],
  "exclude": ["node_modules", "dist", "coverage"]
}
