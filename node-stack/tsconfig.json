{
  "compilerOptions": {

    "paths": {
      "@node-stack/*": [
        "./packages/*/dist/index.js",
        "./packages/*/dist"
      ]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": [
      "node"
    ],
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "composite": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "eslint.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
