{
  "compilerOptions": {
    "paths": {},
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": [
      "node"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "composite": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "eslint.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}