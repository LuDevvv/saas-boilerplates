{
  "name": "@workspace/api",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "build": "wrangler deploy --minify --dry-run --outdir dist src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts && vitest run -c vitest.config.logic.ts",
    "test:edge": "vitest run -c vitest.config.ts",
    "test:logic": "vitest run -c vitest.config.logic.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/sentry": "^1.2.2",
    "@hono/zod-openapi": "^0.13.0",
    "@hono/zod-validator": "^0.2.1",
    "@polar-sh/hono": "^0.5.5",
    "@polar-sh/sdk": "^0.46.4",
    "@sentry/cloudflare": "^10.40.0",
    "@workspace/db": "workspace:*",
    "@workspace/services": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/validators": "workspace:*",
    "aws4fetch": "^1.0.19",
    "hono": "^4.2.0",
    "otpauth": "^9.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.18",
    "@cloudflare/workers-types": "^4.20240405.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "2.1.9",
    "@workspace/config": "workspace:*",
    "@workspace/testing": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.30.0",
    "typescript": "^5.4.3",
    "vitest": "^2.1.9",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^3.39.0"
  }
}
